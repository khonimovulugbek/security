<?xml version="1.0" encoding="UTF-8"?>
<databaseChangeLog
        xmlns="http://www.liquibase.org/xml/ns/dbchangelog"
        xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
        xsi:schemaLocation="http://www.liquibase.org/xml/ns/dbchangelog
            http://www.liquibase.org/xml/ns/dbchangelog/dbchangelog-4.27.xsd">

    <!--
        Sequences start at 100 so that IDs 1-99 are reserved for static
        reference data inserted by Liquibase (roles, permissions, admin user).
        JPA will call NEXTVAL (→ 100, 101, …) and never collide with seed rows.
    -->

    <changeSet id="001-1" author="security-module">
        <comment>Sequence for users table PK</comment>
        <createSequence sequenceName="SEQ_USERS"
                        startValue="100"
                        incrementBy="1"
                        minValue="1"
                        ordered="true"/>
    </changeSet>

    <changeSet id="001-2" author="security-module">
        <comment>Sequence for roles table PK</comment>
        <createSequence sequenceName="SEQ_ROLES"
                        startValue="100"
                        incrementBy="1"
                        minValue="1"
                        ordered="true"/>
    </changeSet>

    <changeSet id="001-3" author="security-module">
        <comment>Sequence for permissions table PK</comment>
        <createSequence sequenceName="SEQ_PERMISSIONS"
                        startValue="100"
                        incrementBy="1"
                        minValue="1"
                        ordered="true"/>
    </changeSet>

    <changeSet id="001-4" author="security-module">
        <comment>Sequence for refresh_tokens table PK</comment>
        <createSequence sequenceName="SEQ_REFRESH_TOKENS"
                        startValue="100"
                        incrementBy="1"
                        minValue="1"
                        ordered="true"/>
    </changeSet>

</databaseChangeLog>