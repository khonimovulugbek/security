<?xml version="1.0" encoding="UTF-8"?>
<databaseChangeLog
        xmlns="http://www.liquibase.org/xml/ns/dbchangelog"
        xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
        xsi:schemaLocation="http://www.liquibase.org/xml/ns/dbchangelog
            http://www.liquibase.org/xml/ns/dbchangelog/dbchangelog-4.27.xsd">

    <!--
        SEED DATA
        =========
        IDs 1-99 are reserved for static reference data (sequences start at 100).

        DEFAULT ADMIN CREDENTIALS
        ─────────────────────────
        Username : admin
        Password : Admin@1234!
        BCrypt   : $2a$12$LcjIKNbTDItrdvJAQCr.j.x9LPnGpkqH28RQXS9MxAjv5v9DRQO6
                   (BCrypt cost=12 — CHANGE IMMEDIATELY IN PRODUCTION)

        To regenerate the hash in Java:
            new BCryptPasswordEncoder(12).encode("Admin@1234!")
    -->

    <!-- ── 1. Permissions ──────────────────────────────────────────────── -->
    <changeSet id="008-1" author="security-module">
        <comment>Insert default permissions</comment>

        <insert tableName="PERMISSIONS">
            <column name="ID"          valueNumeric="1"/>
            <column name="NAME"        value="USERS_READ"/>
            <column name="DESCRIPTION" value="Read user accounts"/>
            <column name="DELETED"     valueNumeric="0"/>
            <column name="CREATED_AT"  valueComputed="SYSTIMESTAMP"/>
            <column name="UPDATED_AT"  valueComputed="SYSTIMESTAMP"/>
        </insert>

        <insert tableName="PERMISSIONS">
            <column name="ID"          valueNumeric="2"/>
            <column name="NAME"        value="USERS_WRITE"/>
            <column name="DESCRIPTION" value="Create and update user accounts"/>
            <column name="DELETED"     valueNumeric="0"/>
            <column name="CREATED_AT"  valueComputed="SYSTIMESTAMP"/>
            <column name="UPDATED_AT"  valueComputed="SYSTIMESTAMP"/>
        </insert>

        <insert tableName="PERMISSIONS">
            <column name="ID"          valueNumeric="3"/>
            <column name="NAME"        value="USERS_DELETE"/>
            <column name="DESCRIPTION" value="Delete (soft) user accounts"/>
            <column name="DELETED"     valueNumeric="0"/>
            <column name="CREATED_AT"  valueComputed="SYSTIMESTAMP"/>
            <column name="UPDATED_AT"  valueComputed="SYSTIMESTAMP"/>
        </insert>

        <insert tableName="PERMISSIONS">
            <column name="ID"          valueNumeric="4"/>
            <column name="NAME"        value="ROLES_READ"/>
            <column name="DESCRIPTION" value="Read roles"/>
            <column name="DELETED"     valueNumeric="0"/>
            <column name="CREATED_AT"  valueComputed="SYSTIMESTAMP"/>
            <column name="UPDATED_AT"  valueComputed="SYSTIMESTAMP"/>
        </insert>

        <insert tableName="PERMISSIONS">
            <column name="ID"          valueNumeric="5"/>
            <column name="NAME"        value="ROLES_MANAGE"/>
            <column name="DESCRIPTION" value="Create, update and delete roles"/>
            <column name="DELETED"     valueNumeric="0"/>
            <column name="CREATED_AT"  valueComputed="SYSTIMESTAMP"/>
            <column name="UPDATED_AT"  valueComputed="SYSTIMESTAMP"/>
        </insert>

        <insert tableName="PERMISSIONS">
            <column name="ID"          valueNumeric="6"/>
            <column name="NAME"        value="PERMISSIONS_MANAGE"/>
            <column name="DESCRIPTION" value="Manage permissions"/>
            <column name="DELETED"     valueNumeric="0"/>
            <column name="CREATED_AT"  valueComputed="SYSTIMESTAMP"/>
            <column name="UPDATED_AT"  valueComputed="SYSTIMESTAMP"/>
        </insert>

    </changeSet>

    <!-- ── 2. Roles ────────────────────────────────────────────────────── -->
    <changeSet id="008-2" author="security-module">
        <comment>Insert default roles</comment>

        <insert tableName="ROLES">
            <column name="ID"          valueNumeric="1"/>
            <column name="NAME"        value="ROLE_ADMIN"/>
            <column name="DESCRIPTION" value="Full-access administrative role"/>
            <column name="DELETED"     valueNumeric="0"/>
            <column name="CREATED_AT"  valueComputed="SYSTIMESTAMP"/>
            <column name="UPDATED_AT"  valueComputed="SYSTIMESTAMP"/>
        </insert>

        <insert tableName="ROLES">
            <column name="ID"          valueNumeric="2"/>
            <column name="NAME"        value="ROLE_USER"/>
            <column name="DESCRIPTION" value="Standard authenticated user role"/>
            <column name="DELETED"     valueNumeric="0"/>
            <column name="CREATED_AT"  valueComputed="SYSTIMESTAMP"/>
            <column name="UPDATED_AT"  valueComputed="SYSTIMESTAMP"/>
        </insert>

    </changeSet>

    <!-- ── 3. Role → Permission assignments ───────────────────────────── -->
    <changeSet id="008-3" author="security-module">
        <comment>Assign all permissions to ROLE_ADMIN</comment>
        <insert tableName="ROLE_PERMISSIONS">
            <column name="ROLE_ID"       valueNumeric="1"/>
            <column name="PERMISSION_ID" valueNumeric="1"/>
        </insert>
        <insert tableName="ROLE_PERMISSIONS">
            <column name="ROLE_ID"       valueNumeric="1"/>
            <column name="PERMISSION_ID" valueNumeric="2"/>
        </insert>
        <insert tableName="ROLE_PERMISSIONS">
            <column name="ROLE_ID"       valueNumeric="1"/>
            <column name="PERMISSION_ID" valueNumeric="3"/>
        </insert>
        <insert tableName="ROLE_PERMISSIONS">
            <column name="ROLE_ID"       valueNumeric="1"/>
            <column name="PERMISSION_ID" valueNumeric="4"/>
        </insert>
        <insert tableName="ROLE_PERMISSIONS">
            <column name="ROLE_ID"       valueNumeric="1"/>
            <column name="PERMISSION_ID" valueNumeric="5"/>
        </insert>
        <insert tableName="ROLE_PERMISSIONS">
            <column name="ROLE_ID"       valueNumeric="1"/>
            <column name="PERMISSION_ID" valueNumeric="6"/>
        </insert>
    </changeSet>

    <changeSet id="008-4" author="security-module">
        <comment>Assign read permissions to ROLE_USER</comment>
        <insert tableName="ROLE_PERMISSIONS">
            <column name="ROLE_ID"       valueNumeric="2"/>
            <column name="PERMISSION_ID" valueNumeric="1"/>
        </insert>
        <insert tableName="ROLE_PERMISSIONS">
            <column name="ROLE_ID"       valueNumeric="2"/>
            <column name="PERMISSION_ID" valueNumeric="4"/>
        </insert>
    </changeSet>

    <!-- ── 4. Default admin user ───────────────────────────────────────── -->
    <changeSet id="008-5" author="security-module">
        <comment>
            Insert default admin user.
            PASSWORD: Admin@1234!  (BCrypt cost=12)
            !! CHANGE THIS PASSWORD IMMEDIATELY IN PRODUCTION !!
            Regenerate hash: new BCryptPasswordEncoder(12).encode("Admin@1234!")
        </comment>
        <insert tableName="USERS">
            <column name="ID"                        valueNumeric="1"/>
            <column name="USERNAME"                  value="admin"/>
            <column name="EMAIL"                     value="admin@company.com"/>
            <column name="PASSWORD_HASH"             value="$2a$12$LcjIKNbTDItrdvJAQCr.j.x9LPnGpkqH28RQXS9MxAjv5v9DRQO6"/>
            <column name="FIRST_NAME"                value="System"/>
            <column name="LAST_NAME"                 value="Administrator"/>
            <column name="ENABLED"                   valueNumeric="1"/>
            <column name="ACCOUNT_NON_EXPIRED"       valueNumeric="1"/>
            <column name="ACCOUNT_NON_LOCKED"        valueNumeric="1"/>
            <column name="CREDENTIALS_NON_EXPIRED"   valueNumeric="1"/>
            <column name="DELETED"                   valueNumeric="0"/>
            <column name="CREATED_AT"                valueComputed="SYSTIMESTAMP"/>
            <column name="UPDATED_AT"                valueComputed="SYSTIMESTAMP"/>
        </insert>
    </changeSet>

    <!-- ── 5. Assign ROLE_ADMIN to admin user ─────────────────────────── -->
    <changeSet id="008-6" author="security-module">
        <comment>Assign ROLE_ADMIN to the default admin user</comment>
        <insert tableName="USER_ROLES">
            <column name="USER_ID" valueNumeric="1"/>
            <column name="ROLE_ID" valueNumeric="1"/>
        </insert>
    </changeSet>

</databaseChangeLog>
