<?xml version="1.0" encoding="UTF-8"?>
<databaseChangeLog
        xmlns="http://www.liquibase.org/xml/ns/dbchangelog"
        xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
        xsi:schemaLocation="http://www.liquibase.org/xml/ns/dbchangelog
            http://www.liquibase.org/xml/ns/dbchangelog/dbchangelog-4.27.xsd">

    <!-- ================================================================
         REFRESH_TOKENS table
         - UUID-based token value (stored as VARCHAR2)
         - Soft-revoke via REVOKED flag (token is never deleted, only revoked)
         - TTL enforced both at the DB level (EXPIRES_AT) and in Java
         ================================================================ -->

    <changeSet id="007-1" author="security-module">
        <comment>Create REFRESH_TOKENS table</comment>
        <createTable tableName="REFRESH_TOKENS" remarks="JWT refresh token store">

            <column name="ID" type="NUMBER(19,0)">
                <constraints primaryKey="true" primaryKeyName="PK_REFRESH_TOKENS" nullable="false"/>
            </column>

            <!-- UUID token value (36 chars) -->
            <column name="TOKEN" type="VARCHAR2(512 CHAR)" remarks="UUID refresh token value">
                <constraints nullable="false"/>
            </column>

            <column name="USER_ID" type="NUMBER(19,0)">
                <constraints nullable="false"/>
            </column>

            <column name="EXPIRES_AT" type="TIMESTAMP WITH TIME ZONE">
                <constraints nullable="false"/>
            </column>

            <!-- 0 = active, 1 = revoked (logout / rotation) -->
            <column name="REVOKED" type="NUMBER(1,0)" defaultValueNumeric="0">
                <constraints nullable="false"/>
            </column>

            <column name="CREATED_AT" type="TIMESTAMP WITH TIME ZONE">
                <constraints nullable="false"/>
            </column>

        </createTable>
    </changeSet>

    <changeSet id="007-2" author="security-module">
        <comment>Unique constraint, FK, check constraint and indexes on REFRESH_TOKENS</comment>
        <addUniqueConstraint tableName="REFRESH_TOKENS" columnNames="TOKEN"
                             constraintName="UQ_REFRESH_TOKENS_TOKEN"/>
        <addForeignKeyConstraint
                baseTableName="REFRESH_TOKENS"  baseColumnNames="USER_ID"
                referencedTableName="USERS"      referencedColumnNames="ID"
                constraintName="FK_REFRESH_TOKENS_USER"
                onDelete="CASCADE"/>
        <sql>ALTER TABLE REFRESH_TOKENS ADD CONSTRAINT CHK_RT_REVOKED CHECK (REVOKED IN (0,1))</sql>
        <createIndex tableName="REFRESH_TOKENS" indexName="IDX_RT_TOKEN">
            <column name="TOKEN"/>
        </createIndex>
        <createIndex tableName="REFRESH_TOKENS" indexName="IDX_RT_USER_ID">
            <column name="USER_ID"/>
        </createIndex>
        <createIndex tableName="REFRESH_TOKENS" indexName="IDX_RT_EXPIRES_AT">
            <column name="EXPIRES_AT"/>
        </createIndex>
    </changeSet>

</databaseChangeLog>
